# Cargo build artifacts
compiler/target/
**/target/

# Packaged installer output (regenerate with .\package.ps1)
dist/

# Spass build output (regenerated by `spass build`)
examples/*/build/

# spasio file-mode output (written by running examples; `input/` fixtures
# stay tracked — e.g. examples/await/data/input/height.spb)
examples/*/data/output/

# Local test artifacts (e.g. test_module.exe from manual compile runs)
examples/**/*.exe
test_module*.exe
sculpt_output.txt
test_output.txt

# Development scripts and local agent state: never published
*.py
__pycache__/
*.pyc
.codebuddy/
.workbuddy/

# Scratch artefacts from development: never published
/_*.txt
/b_*.txt
/rb_*.txt
/build2.txt
/cargo_path.txt
/diff_*.txt
/head_*.rs
/head_*.txt
/test[0-9].txt
/pass
/start_req.json
/lib.rs
*.log
TAPR-public-*.md

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
.vscode/
.idea/
